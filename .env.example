# Copy this file to .env.local for local development.
# On Vercel, add each of these under Project → Settings → Environment Variables.

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Secret! Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-secret-key   # sb_secret_... (or the legacy service_role key)

# --- Claude API (console.anthropic.com → API Keys) ---
# Secret! Server only.
ANTHROPIC_API_KEY=sk-ant-...
# Model used by Believer and Purity. Check docs.claude.com for current model names.
ANTHROPIC_MODEL=claude-sonnet-5-5
# Messages + pictures each member can send per day (keeps your API bill predictable).
AI_DAILY_LIMIT=60
# AI Pass: free tries per account, then pay this many dollars of BNB (to NEXT_PUBLIC_TREASURY_WALLET) for this many days.
NEXT_PUBLIC_AI_FREE_PER_DAY=5
# Low-cost model for free messages and the Launch Pad guide (ANTHROPIC_MODEL is used for AI Pass subscribers)
ANTHROPIC_FAST_MODEL=claude-haiku-5-5
NEXT_PUBLIC_AI_PASS_USD=5
NEXT_PUBLIC_AI_PASS_DAYS=30

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://autistik.io

# --- $AUTISTIK on BNB Smart Chain ---
NEXT_PUBLIC_TOKEN_ADDRESS=0x483EC705AC912587Fe7cD75Caf3ecC0A118aA6a9
# Fill in after you deploy contracts/AutistikAirdrop.sol (see README, step 7).
NEXT_PUBLIC_AIRDROP_CONTRACT=

# --- AUTISTIK Launch Pad (see README → "Launch Pad") ---
# Address of AutistikLaunchpad on each chain. Leave empty to keep that chain "coming soon".
NEXT_PUBLIC_LAUNCHPAD_BSC=
NEXT_PUBLIC_LAUNCHPAD_ETHEREUM=
NEXT_PUBLIC_LAUNCHPAD_ROBINHOOD=
# $20 AUTISTIK rule: the server checks the creator's AUTISTIK on BNB Chain and signs a 15-minute permit.
# Secret! Server only. A NEW private key used ONLY for signing permits (it never needs any coins).
# Put its address in the contract's eligibilitySigner_ field when you deploy. Leave empty to switch the check off
# (then also deploy with eligibilitySigner_ = 0x0000000000000000000000000000000000000000).
ELIGIBILITY_SIGNER_KEY=
# Minimum AUTISTIK a creator must hold, in US dollars.
NEXT_PUBLIC_LAUNCH_MIN_HOLD_USD=20

# --- Trade page referral links (your affiliate/referral URL from each exchange; leave empty to show a plain link) ---
NEXT_PUBLIC_REF_BINANCE=
NEXT_PUBLIC_REF_BYBIT=
NEXT_PUBLIC_REF_OKX=
NEXT_PUBLIC_REF_BITGET=
NEXT_PUBLIC_REF_MEXC=
NEXT_PUBLIC_REF_KUCOIN=
NEXT_PUBLIC_REF_ASTER=

# --- Trending & listing (paid in BNB on BNB Chain) ---
# Wallet that receives trending/listing payments. Shown on the site. Use your treasury/deployer wallet.
NEXT_PUBLIC_TREASURY_WALLET=
# Price in US dollars (paid in BNB at the live price) and how many hours one payment trends for.
NEXT_PUBLIC_TRENDING_USD=20
NEXT_PUBLIC_TRENDING_HOURS=24
# Optional: your own RPC links (the defaults are free public ones).
NEXT_PUBLIC_BSC_RPC=
NEXT_PUBLIC_ETHEREUM_RPC=
# Robinhood Chain: fill in from Robinhood's official docs when you deploy there.
NEXT_PUBLIC_ROBINHOOD_CHAIN_ID=
NEXT_PUBLIC_ROBINHOOD_RPC=
NEXT_PUBLIC_ROBINHOOD_EXPLORER=
NEXT_PUBLIC_ROBINHOOD_DEX_NAME=
# Path DexScreener uses for Robinhood Chain (dexscreener.com/<this>/<pair>). Empty = use DexScreener search.
NEXT_PUBLIC_ROBINHOOD_DEXSCREENER_SLUG=
# Swap page with {token} where the token address goes, e.g. https://dex.example/swap?outputCurrency={token}
NEXT_PUBLIC_ROBINHOOD_SWAP_URL=

# --- "Are you human" check (Cloudflare Turnstile, free). Leave empty to switch it off. ---
# Also paste the secret into Supabase → Authentication → Attack Protection → Captcha (Turnstile), after redeploying.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Analytics: top 40 holders and holding times (moralis.com, free plan). Without it, the top 10 from GoPlus are shown.
MORALIS_API_KEY=
MORALIS_DAILY_LIMIT=600

# Swap across networks (LI.FI). Works without any key. To earn the 0.5% fee on cross-network swaps, register this
# site at portal.li.fi with the treasury as fee wallet and put the integrator name here. An API key raises rate limits.
LIFI_INTEGRATOR=
LIFI_API_KEY=

# Built-in AUTISTIK wallet (Privy). The app ID is public; the secret is SERVER ONLY (mark it Sensitive in Vercel).
# With the secret, each member's wallet is made as soon as they confirm their email.
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# AUTISTIK Solana Locker program ID (programs/autistik-locker). Leave empty and Solana launches only burn their LP tokens.
NEXT_PUBLIC_SOLANA_LOCKER_PROGRAM=
# AUTISTIK marketing wallet on Solana (public address). It receives the Solana launch fee and 0.5% of every Solana
# swap made on the Hub (paid in SOL, like pump.fun). Leave empty and Solana launches and swaps carry no AUTISTIK fee.
NEXT_PUBLIC_SOLANA_FEE_WALLET=
# The Solana launch fee in SOL (default 0.02).
NEXT_PUBLIC_SOLANA_LAUNCH_FEE_SOL=0.02
